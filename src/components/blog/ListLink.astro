---
import type { CollectionEntry } from "astro:content";
import { type Lang, hrefForLang } from "../../i18n/utils";

interface Props {
    lang: Lang;
    post: CollectionEntry<"blogFr"> | CollectionEntry<"blogEn">;
}

const { post, lang } = Astro.props;

const href = hrefForLang(`/blog/${post.id}/`, lang);
const publishDateString = post.data.pubDate.toISOString().slice(0, 10);
---

<li>
    <a href={href}>
        <article>
            <h2>{post.data.title}</h2>
            <time datetime={publishDateString}>{publishDateString}</time>
            <p>{post.data.description}</p>
        </article>
    </a>
</li>

<style>
    li {
        list-style: none !important;
    }

    time {
        font-size: 0.8em;
    }
</style>
