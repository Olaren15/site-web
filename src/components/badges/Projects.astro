---
import Badge from "./Badge.astro";
import Badges from "./Badges.astro";
---

<Badges>
    <Badge
        href="https://eightyeightthirty.one/"
        title="button buttons always more buttons!"
        src="https://eightyeightthirty.one/88x31.png"
        alt="rightyeightthirty.one"
    />
    <Badge
        href="https://moonlight-mod.github.io/"
        title="simply the best discord client mod"
        src="/88x31/moonlight.gif"
        alt="Mod your Discord. moonlight Now!"
    />
    <Badge href="https://goatcorp.github.io/" title="makes ffxiv playable" src="/88x31/goatcorp.png" alt="goatcorp" />
    <Badge
        href="https://pdsls.dev"
        title="how else are you supposed to dev for atproto"
        src="https://pdsls.dev/88x31.webp"
        alt="pdsls"
    />
    <Badge
        href="https://ublockorigin.com/"
        title="made in québec!!"
        src="/88x31/ublockorigin.png"
        alt="uBlock Origin Now!"
    />
    <Badge
        href="https://neovim.io/"
        title="vim vs emacs is dead, long live neovim vs helix!"
        src="/88x31/neovim.png"
        alt="Made with neovim"
    />
    <Badge
        href="https://www.rust-lang.org/"
        title="least worse language of them all"
        src="/88x31/rust.gif"
        alt="Rust. It's memory safe! Guys it's memory safe! Memory safety guys. Memory safety is priority"
    />
    <Badge
        href="https://debian.org"
        title="runs on all my servers, rock solid and FOSS"
        src="/88x31/debian.gif"
        alt="Debian GNU/Linux"
    />
    <Badge
        href="https://nixos.org"
        title="cool distro, I would use it if I had more free time"
        src="/88x31/nix.gif"
        alt="I love reproducing. I use Nix by the way"
    />
    <Badge
        href="https://grapheneos.org/"
        title="fighting the good fight against big tech"
        src="/88x31/graphene.gif"
        alt="GrapheneOS"
    />
    <Badge
        href="https://www.qbittorrent.org/"
        title="i <3 p2p"
        src="/88x31/qbittorrent.png"
        alt="qbittorrent | don't forget to seed!"
    />
    <Badge
        href="https://en.wikipedia.org/"
        title="maybe the only place to find reliable information these days"
        src="/88x31/wikipedia.gif"
        alt="Wikipedi"
    />
    <Badge
        href="https://bandcamp.com/"
        title="support your favourite artists!"
        src="/88x31/bandcamp.png"
        alt="Bandcamp"
    />
    <Badge
        href="https://stm.info/"
        title="public transit makes cities better"
        src="/88x31/stm.webp"
        alt="Société de transport de Montréal"
    />
</Badges>
