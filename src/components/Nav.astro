---
import { type Lang, hrefForLang } from "../i18n/utils";

interface Props {
    lang: Lang;
    hideLanguageSwitcher?: boolean;
}

const { lang, hideLanguageSwitcher } = Astro.props;

const text = {
    fr: {
        blog: "Blogue",
        swapLang: "English",
    },
    en: {
        blog: "Blog",
        swapLang: "Français",
    },
};
---

<header>
    <nav>
        <a class="logo" href={hrefForLang("/", lang)}>olaren.dev</a>
        <ul>
            <li>
                <a href={hrefForLang("/blog", lang)}>{text[lang].blog}</a>
            </li>
            {
                !hideLanguageSwitcher && (
                    <li>
                        <a href={hrefForLang(Astro.url.pathname.replace("/en", ""), lang === "fr" ? "en" : "fr")}>
                            {text[lang].swapLang}
                        </a>
                    </li>
                )
            }
        </ul>
    </nav>
</header>

<style>
    header {
        display: flex;
        justify-content: center;

        width: 100%;

        margin-bottom: 2em;

        background-color: var(--background-200);
        border-bottom: 1px solid var(--background-400);
    }

    nav {
        width: 100%;
        max-width: calc(var(--width) - var(--padding));

        padding: 1em var(--padding);

        display: flex;
        justify-content: space-between;
        align-items: baseline;

        flex-wrap: wrap;
        gap: 1em;

        font-weight: bold;
    }

    .logo {
        font-size: 1.5em;
        color: var(--primary-800);
    }

    ul {
        display: flex;
        gap: 1em;
    }

    li {
        list-style-type: none;

        a {
            color: var(--primary-800);
        }
    }
</style>
