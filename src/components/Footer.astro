---
import { type Lang } from "../i18n/utils";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;

const text = {
    fr: {
        thankYou: "Merci d'avoir visité!",
    },
    en: {
        thankYou: "Thank you for visiting!",
    },
};
---

<footer>
    <slot />
    <p>{text[lang].thankYou}</p>
    <iframe
        lang="en"
        src="https://ad.ari.lt/ads/embed?from=olaren.dev"
        sandbox="allow-popups allow-popups-to-escape-sandbox"
        referrerpolicy="no-referrer"
        title="An embed showing a silly image and author information."
        style="border:none;max-width:100%"
        width="722"
        height="98"
        loading="lazy"
        role="img"></iframe>
</footer>

<style>
    footer {
        width: 100%;
        max-width: calc(var(--width) - var(--padding));

        padding: 1em var(--padding);
        margin-top: 2em;

        border-top: solid 1px var(--background-400);
    }

    p {
        margin-top: 1em;
    }
</style>
