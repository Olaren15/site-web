---
import { getCollection } from "astro:content";
import BlogList from "../../../components/blog/List.astro";
import Layout from "../../../layouts/Layout.astro";

const lang = "en";
const articles = await getCollection("blogEn");
---

<Layout lang={lang} title="Catherine - Blog">
    <div class="md-look">
        <BlogList lang={lang} posts={articles} />
    </div>
</Layout>
